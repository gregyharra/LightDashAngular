{
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "target": "ES2022",
    "module": "ES2022",
    "paths": {
      "@mds-ui/models": [
        "./libs/models/src/index.ts"
      ],
      "@mds-ui/core": [
        "./libs/core/src/index.ts"
      ],
      "@mds-ui/shared": [
        "./libs/shared/src/index.ts"
      ],
      "@mds-ui/features/auth": [
        "./libs/features/auth/src/index.ts"
      ],
      "@mds-ui/features/projects": [
        "./libs/features/projects/src/index.ts"
      ],
      "@mds-ui/features/warehouses": [
        "./libs/features/warehouses/src/index.ts"
      ],
      "@mds-ui/features/tables": [
        "./libs/features/tables/src/index.ts"
      ],
      "@mds-ui/features/explorer": [
        "./libs/features/explorer/src/index.ts"
      ],
      "@mds-ui/features/charts": [
        "./libs/features/charts/src/index.ts"
      ],
      "@mds-ui/features/dashboards": [
        "./libs/features/dashboards/src/index.ts"
      ],
      "@mds-ui/features/lineage": [
        "./libs/features/lineage/src/index.ts"
      ],
      "@mds-ui/features/ai": [
        "./libs/features/ai/src/index.ts"
      ],
      "@mds-ui/features/export": [
        "./libs/features/export/src/index.ts"
      ]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  }
}
