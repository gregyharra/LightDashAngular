{
  "name": "remoteCharts",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/remote-charts/src",
  "tags": [
    "type:app"
  ],
  "targets": {
    "build": {
      "executor": "@nx/angular:webpack-browser",
      "outputs": [
        "{options.outputPath}"
      ],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/remote-charts",
        "index": "apps/remote-charts/src/index.html",
        "main": "apps/remote-charts/src/main.ts",
        "polyfills": [
          "zone.js"
        ],
        "tsConfig": "apps/remote-charts/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/remote-charts/public"
          }
        ],
        "styles": [
          "apps/remote-charts/src/styles.scss"
        ],
        "customWebpackConfig": {
          "path": "apps/remote-charts/webpack.config.ts"
        }
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "12kb",
              "maximumError": "16kb"
            }
          ],
          "outputHashing": "all",
          "customWebpackConfig": {
            "path": "apps/remote-charts/webpack.prod.config.ts"
          }
        },
        "development": {
          "buildOptimizer": false,
          "optimization": false,
          "vendorChunk": true,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/angular:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "port": 4206,
        "publicHost": "http://localhost:4206"
      },
      "configurations": {
        "production": {
          "buildTarget": "remoteCharts:build:production"
        },
        "development": {
          "buildTarget": "remoteCharts:build:development"
        }
      },
      "dependsOn": [
        "shell:serve"
      ]
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "remoteCharts:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "apps/remote-charts/jest.config.ts",
        "tsConfig": "apps/remote-charts/tsconfig.spec.json"
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "defaultConfiguration": "production",
      "options": {
        "buildTarget": "remoteCharts:build",
        "port": 4206,
        "watch": false
      },
      "configurations": {
        "development": {
          "buildTarget": "remoteCharts:build:development"
        },
        "production": {
          "buildTarget": "remoteCharts:build:production"
        }
      }
    }
  }
}
