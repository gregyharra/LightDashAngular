{
  "name": "feature-ai",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/feature-ai/src",
  "prefix": "mds",
  "projectType": "library",
  "tags": [
    "type:feature"
  ],
  "targets": {
    "build": {
      "executor": "@nx/angular:ng-packagr-lite",
      "outputs": [
        "{workspaceRoot}/dist/{projectRoot}"
      ],
      "defaultConfiguration": "production",
      "options": {
        "project": "libs/feature-ai/ng-package.json",
        "tsConfig": "libs/feature-ai/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/feature-ai/tsconfig.lib.prod.json"
        },
        "development": {}
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "libs/feature-ai/jest.config.ts",
        "tsConfig": "libs/feature-ai/tsconfig.spec.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
