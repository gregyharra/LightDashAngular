# App metadata database (PostgreSQL). Use sqlite+pysqlite:///:memory: for ephemeral tests.
DATABASE_URL=postgresql+psycopg2://mds:mds@localhost:5432/mds

# Comma-separated list of allowed browser origins (Angular dev server by default).
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Public Angular origin for password-reset URLs printed by the CLI.
# Defaults to the first CORS origin when unset.
# APP_ORIGIN=http://localhost:4200
# PUBLIC_APP_URL=http://localhost:4200

# Cookie session settings (override in production).
# SESSION_SECRET=mds-dev-session-secret-change-me
# SESSION_TTL_HOURS=168
# SESSION_COOKIE_SECURE=true

# Tables are always created on startup; set to true only to insert demo rows automatically.
# Or run manually: python -m mds.scripts.seed_demo
SEED_DEMO_DATA=false

# Local dbt project (no Git). Use an absolute path or path relative to mds-backend/.
DBT_PROJECT_PATH=../mds-transform

# Optional: override where manifest.json / catalog.json live (default: {DBT_PROJECT_PATH}/target)
# DBT_ARTIFACTS_PATH=/path/to/dbt/target

# When true, regenerate manifest.json from project sources when stale (before semantic reads).
# Refresh endpoint always checks staleness regardless of this flag.
# Git sync (manual or startup resync) always re-parses after clone/pull regardless of this
# setting — startup recovery is useless without a fresh manifest.
# AUTO_REGENERATE_MANIFEST=true

# Local directory for cloned project Git repositories (one folder per project UUID).
PROJECTS_DATA_DIR=.data/projects

# Fernet key for encrypting warehouse connection passwords at rest.
# Optional for local development — a fixed dev key is used when unset (see startup log warning).
# Required in production. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ENCRYPTION_KEY=

# Runtime environment. Non-production defaults mds.* loggers to DEBUG (no .env required for local dev).
# ENVIRONMENT=development
#
# With ENVIRONMENT=production, startup re-syncs every project that has a Git URL
# (clone/pull + dbt parse) before accepting traffic. Per-project failures set
# git_sync_status=error but do not block other projects or prevent the API from starting.
#
# Escape hatch: set to false to skip the blocking startup resync entirely
# (e.g. if it is causing crash-loops). Defaults to true in production.
# STARTUP_RESYNC_GIT_PROJECTS=true
#
# Total time budget (seconds) for the startup resync loop across all projects.
# Any projects not yet attempted when the budget is exceeded are marked
# git_sync_status=error with "startup resync time budget exceeded".
# STARTUP_RESYNC_TIMEOUT_SECONDS=300

# Optional override for mds.* log level (DEBUG, INFO, WARNING, ERROR).
# LOG_LEVEL=DEBUG

# Log compiled warehouse SQL at INFO before Trino execution (also logged at DEBUG by default in development).
# LOG_SQL_QUERIES=true

# Product flag for Ask AI (UI + /ai/chat). Defaults to off when unset.
# ASK_AI_ENABLED=true

# Optional OpenAI-compatible API for the Ask AI assistant (heuristic replies work without a key).
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
